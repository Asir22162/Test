{
  "name": "@weixin/shared-api",
  "version": "0.0.0",
  "scripts": {
    "generate-types": "npx openapi-typescript openapi.yaml --output src/types.ts",
    "validate-openapi": "npx @apidevtools/swagger-cli validate openapi.yaml",
"generate-types-check": "node ./scripts/generate-types-check.js",
    "test": "vitest",
    "pact:consumer": "vitest tests/pact.consumer.test.ts",
    "pact:provider-verify": "vitest tests/pact.provider.test.ts",
    "pact:publish": "node ./scripts/publish-pacts.js",
    "test:publish": "vitest tests/publish.test.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "@apidevtools/swagger-cli": "^4.0.0",
    "@pact-foundation/pact": "^10.0.0",
    "vitest": "^1.0.0",
    "express": "^4.18.0",
    "body-parser": "^1.20.0",
    "node-fetch": "^3.3.2",
    "nock": "^13.0.11"
  }
} 