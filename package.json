{
  "name": "weixin-mall-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.0.0",
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "libs/*",
    "ops"
  ],
  "scripts": {
    "build": "pnpm -w -r run build",
    "lint": "pnpm -w -r run lint",
    "test": "pnpm -w -r run test",
    "bootstrap": "pnpm install",
    "generate-types": "pnpm -w -r --filter packages/shared-api... run generate-types",
    "precommit:generate-types-check": "pnpm --filter ./packages/shared-api... run generate-types-check",
    "prepare": "husky install",
    "lint:fix": "pnpm -w -r run lint:fix",
    "prepare:h": "husky install && npx husky add .husky/pre-commit 'pnpm -w -r run lint:fix'"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^10.0.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^2.0.0",
    "turbo": "^1.4.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}